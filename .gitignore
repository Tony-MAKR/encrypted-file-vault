# Secrets and local configuration
.env
.env.*
!.env.example

# Python
backend/.venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
