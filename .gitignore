# Application data: never commit databases, vault blobs, logs or backups
data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.log

# Test / quality reports (generated later)
test_reports/
quality_reports/

# OS / editors
